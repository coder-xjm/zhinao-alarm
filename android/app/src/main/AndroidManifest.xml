<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==================== 闹钟核心权限 ==================== -->

    <!-- 精确闹钟：Android 12+ 需用户手动授予，否则只能"大致准时" -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 闹钟类 App 免申请通道（Android 13+） -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 开机后重排闹钟，否则重启一次闹钟就全丢了 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 响铃时点亮屏幕 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 把闹钟音量拉到最大 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 前台服务：响铃时保活，Android 14+ 需声明具体类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- v1.2.0 后台守护服务（常驻通知，防止被小米清理掉闹钟排程） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 锁屏直接弹出响铃页 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 通知权限（Android 13+ 需动态申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 申请"电池优化豁免"，小米必开 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 预留：V2 联网更新法定节假日日历 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="智闹"
        android:name="${applicationName}"
        android:icon="@android:drawable/ic_lock_idle_alarm">

        <!-- ==================== 主界面（Flutter） ==================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================== 全屏响铃页（原生） ==================== -->
        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/RingTheme" />

        <!-- ==================== 响铃前台服务 ==================== -->
        <!-- stopWithTask="false"：用户划掉最近任务时不要顺手把正在响的闹钟也停掉 -->
        <service
            android:name=".RingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ==================== 后台守护前台服务（v1.2.0 新增） ====================
             常驻通知栏显示「下次响铃」，并在用户划掉任务（onTaskRemoved）时立刻重排闹钟。
             stopWithTask="false" 是关键：没有它，划掉任务就等于把这份保险一起划掉了。 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm_guard: 保持闹钟排程有效并在通知栏显示下一次响铃时间" />
        </service>

        <!-- ==================== 闹钟到点广播 ==================== -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- ==================== 定时自检看门狗（v1.2.0 新增） ====================
             每 15 分钟检查一次闹钟排程是否还在，丢了的自动补排。 -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false" />

        <!-- ==================== 系统事件广播（开机等） ==================== -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 国产 ROM 的快速开机 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.android.quickboot.poweron" />
                <!-- 覆盖安装后 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 用户改了时间 / 时区 / 日期，周几和几号的计算会变 -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
        Android 11+ 需要显式声明可查询的包，
        否则 resolveActivity 检测不到厂商的「自启动管理」页面，跳转会直接失败。
    -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.vivo.permissionmanager" />
    </queries>
</manifest>
